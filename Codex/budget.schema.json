{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Budget",
  "description": "Budget record for a project",
  "type": "object",
  "required": ["id", "project_id", "currency"],
  "properties": {
    "id": {"type": "string"},
    "project_id": {"type": "string"},
    "currency": {"type": "string", "default": "GBP"},
    "approved": {"type": "number", "minimum": 0},
    "committed": {"type": "number", "minimum": 0},
    "spent": {"type": "number", "minimum": 0},
    "forecast": {"type": "number", "minimum": 0},
    "funding_sources": {
      "type": "array",
      "items": {"type": "object","properties": {"source": {"type":"string"}, "amount": {"type":"number"}}, "required": ["source","amount"]}
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
