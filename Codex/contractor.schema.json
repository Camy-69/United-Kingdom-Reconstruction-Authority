{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contractor",
  "description": "Contractor record",
  "type": "object",
  "required": ["id", "company_name"],
  "properties": {
    "id": {"type": "string"},
    "company_name": {"type": "string"},
    "registration_number": {"type": ["string","null"]},
    "country": {"type": "string", "default": "UK"},
    "contracts": {"type": "array", "items": {"type": "string"}},
    "performance_score": {"type": "number", "minimum": 0, "maximum": 100},
    "safety_record": {
      "type": "object",
      "properties": {"incidents_last_3_years": {"type":"integer","minimum":0}, "fatalities": {"type":"integer","minimum":0}},
      "additionalProperties": false
    },
    "contact": {"type":"object","properties": {"website": {"type":"string","format":"uri"}, "email": {"type":"string","format":"email"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
